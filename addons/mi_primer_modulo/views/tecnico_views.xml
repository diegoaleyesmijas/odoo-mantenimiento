<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tecnico_list" model="ir.ui.view">
        <field name="name">mi_modulo.tecnico.list</field>
        <field name="model">mi_modulo.tecnico</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="especialidad"/>
            </list>
        </field>
    </record>

    <record id="view_tecnico_form" model="ir.ui.view">
        <field name="name">mi_modulo.tecnico.form</field>
        <field name="model">mi_modulo.tecnico</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                       
                        <field name="especialidad"/>
                    </group>
                    <group>
                        <field name="email"/>
                      
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tecnico" model="ir.actions.act_window">
        <field name="name">Técnicos</field>
        <field name="res_model">mi_modulo.tecnico</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_tecnico" name="Técnicos" parent="menu_demo_root" action="action_tecnico"/>
</odoo>