<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_demo_solo_sus_tareas" model="ir.rule">
        <field name="name">Demo: cada tecnico ve sus tareas</field>
        <field name="model_id" ref="model_mi_modulo_demo"/>
        <field name="domain_force">[('tecnico_id.usuario_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tecnico_demo'))]"/>
    </record>

    <record id="rule_demo_admin_todo" model="ir.rule">
        <field name="name">Demo: admin ve todo</field>
        <field name="model_id" ref="model_mi_modulo_demo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin_demo'))]"/>
    </record>
</odoo>