<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_practicas" model="ir.module.category">
        <field name="name">Practicas Odoo</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_tecnico_demo" model="res.groups">
        <field name="name">Tecnico (demo)</field>
        <field name="category_id" ref="module_category_practicas"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_admin_demo" model="res.groups">
        <field name="name">Admin (demo)</field>
        <field name="category_id" ref="module_category_practicas"/>
        <field name="implied_ids" eval="[(4, ref('group_tecnico_demo'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>